{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2020",
		"lib": ["es2021"],
		"moduleResolution": "node",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"types": ["node"]
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts"]
}
