# Port the high-score API server listens on.
# PORT=8080

# Port the webpack dev server listens on.
# DEV_SERVER_PORT=3000

# URL the webpack dev server proxies /api requests to (the high-score API
# server above). Must not point back at the dev server itself.
# SCORES_API_URL=http://localhost:8080

# Postgres connection string. If unset, scores are stored in a local JSON
# file instead (see SCORES_FILE below).
# Example (Supabase pooler connection, recommended for serverless/short-lived
# connections):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Set to "disable" to turn off TLS when connecting to a local/self-hosted
# Postgres instance. Leave unset (TLS on) when using Supabase or another
# hosted Postgres provider.
# DATABASE_SSL=disable

# Path to the JSON file used as a fallback store when DATABASE_URL is not set.
# SCORES_FILE=server/data/scores.json
